.{
    .name = .libd2,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x5edb35b5ed14bac1,

    // The root package re-exports each sub-package's public module so an EXTERNAL
    // project can depend on libd2 once (`.libd2 = .{ .path = "…/libd2" }`) and
    // `@import` any of them via `dep.module("d2-…")`. See docs/consuming-libd2.md.
    .dependencies = .{
        .d2_core = .{ .path = "packages/core" },
        .d2_data = .{ .path = "packages/data" },
        .d2_sim = .{ .path = "packages/sim" },
        .d2_items = .{ .path = "packages/items" },
        .d2_drlg = .{ .path = "packages/drlg" },
        .d2_formats = .{ .path = "packages/formats" },
        .d2_fog = .{ .path = "packages/fog" },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "packages",
        "README.md",
        "LICENSE",
        "docs",
        "scripts",
    },
}
