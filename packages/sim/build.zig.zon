.{
    .name = .d2_sim,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0xbba303ff364e0fd6,

    // The shared Stat/Item model foundation (seed-RNG, Stat/StatList, ...) lives
    // in d2-core; sim re-exports those types so its public API is unchanged.
    .dependencies = .{
        .d2_core = .{ .path = "../core" },
        .d2_data = .{ .path = "../data" },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
    },
}
