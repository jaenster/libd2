.zig-cache/
zig-out/
.idea/
.env
**/zig-cache
**/zig-out

# Generated visualisations (large embedded map data)
packages/pathfinding/viz/

# NuGet: native assets are staged by scripts/nuget-pack.sh, plus dotnet build output
packages/dotnet/**/runtimes/
packages/dotnet/**/bin/
packages/dotnet/**/obj/
*.nupkg

# Go: native assets + their generated embed files are staged by scripts/go-sync-natives.sh
packages/go/**/natives/
packages/go/**/embed_*.go
